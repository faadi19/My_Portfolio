# Your site URL (e.g. https://yoursite.com). Used for canonical, OG, and manifest. No trailing slash.
VITE_SITE_URL=https://muhammadfahad.netlify.app

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Get it from https://analytics.google.com → Admin → Data Streams → your web stream.
# Leave empty or omit to disable analytics.
VITE_GA_ID=

# Formspree form URL (e.g. https://formspree.io/f/yourformid).
# Create a form at https://formspree.io and paste the form endpoint here.
# Submissions are sent to the email you use for that Formspree form.
# Leave empty to hide the contact form (mailto links only).
VITE_FORMSPREE_URL=

# Optional: hero background video URL (MP4, muted loop). Leave empty for 3D scene only.
# VITE_HERO_VIDEO_URL=
